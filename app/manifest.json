{
  "manifest_version": 2,
  "name": "Trust Badger",
  "version": "0.1",
  "description": "Scores info content and sends to backend.",
  "permissions": [
    "activeTab",
    "tabs",        // better than "scripting" for MV2
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "Trust Badger"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"]   // <-- match actual file name
    }
  ]
}
