# VaultBubble Beta - Environment Configuration
# Copy this file to .env and modify as needed

# Database Configuration
# These match the docker-compose.yml settings
DATABASE_URL=postgresql+psycopg2://badger:badgerpass@db:5432/badgerdb

# Model Provider Configuration
MODEL_PROVIDER=ollama

# Ollama Configuration
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=phi3.5-mini-q2k
OLLAMA_EMBED_MODEL=all-minilm

# Optional: OpenAI Configuration (if switching to OpenAI provider)
# OPENAI_API_KEY=your-api-key-here

# Optional: Application Settings
# LOG_LEVEL=INFO
# DEBUG=false
