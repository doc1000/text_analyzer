# VaultBubble Beta - Environment Configuration
# Copy this file to .env and modify as needed

# Database Configuration
# These match the docker-compose.yml settings
DATABASE_URL=postgresql+psycopg2://badger:badgerpass@db:5432/badgerdb

# Model Provider Configuration
# VaultBubble now supports separate providers for different functions
# Each can be set to "ollama" (default, local) or "openai" (requires API key)
CHAT_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
TOPIC_PROVIDER=ollama

# Ollama Configuration
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_TOPIC_MODEL=gemma3:1b-it-q4_K_M
OLLAMA_EMBED_MODEL=all-minilm

# Optional: OpenAI Configuration (required if using openai provider)
# OPENAI_API_KEY=your-api-key-here

# Optional: Application Settings
# LOG_LEVEL=INFO
# DEBUG=false
