# VaultBubble - Environment Configuration
# Copy this file to .env and modify as needed
# Works with both: docker compose up AND uvicorn app.main:app

# =============================================================================
# DATABASE
# =============================================================================
# For Docker Compose (internal network):
DATABASE_URL=postgresql+psycopg2://badger:badgerpass@db:5432/badgerdb

# For standalone/Fly.io (will be overridden by Fly's DATABASE_URL):
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname

# =============================================================================
# EMBEDDING PROVIDER
# =============================================================================
# Options: "ollama" (local), "openai", "huggingface" (cloud)
EMBEDDING_PROVIDER=ollama

# --- Ollama (local, default) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=all-minilm

# --- OpenAI ---
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small

# --- HuggingFace Inference API (recommended for cloud) ---
# EMBEDDING_PROVIDER=huggingface
# HUGGINGFACE_API_TOKEN=hf_...
# HUGGINGFACE_EMBED_MODEL=BAAI/bge-small-en-v1.5
# HUGGINGFACE_EMBED_URL=https://router.huggingface.co/hf-inference/models/{model}

# =============================================================================
# CHAT/LLM PROVIDER (for queries and topic generation)
# =============================================================================
# Options: "ollama" (local), "openai"
CHAT_PROVIDER=ollama
TOPIC_PROVIDER=ollama

# --- Ollama models ---
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_TOPIC_MODEL=gemma3:1b-it-q4_K_M

# --- OpenAI ---
# CHAT_PROVIDER=openai
# TOPIC_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_CHAT_MODEL=gpt-4o-mini

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Set to "true" to require API key authentication on all endpoints
VB_REQUIRE_AUTH=false

# Bootstrap token for creating initial API keys (required for /auth/bootstrap/*)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
VB_BOOTSTRAP_TOKEN=dev-bootstrap-token-change-me

# Pepper for API key hashing (optional but recommended for production)
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
VB_API_KEY_PEPPER=

# =============================================================================
# INGESTION PACKAGE SETTINGS
# =============================================================================
# vbub-doc-ingestion is installed as a Python package (in-process, no HTTP).
# These settings configure the package when it runs inside VaultBubbles.
#
# Path where the ingestion package writes the original binary for each uploaded
# file. On ephemeral filesystems (e.g. Fly.io without a volume) these files
# are lost on restart; VaultBubbles only needs the extracted text, so this is
# acceptable. Attach a Fly volume and set an absolute path if binary retention
# is required.
#   Default: ./data/blobs
# BINARY_STORAGE_PATH=./data/blobs

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================
# LOG_LEVEL=INFO
# DEBUG=false
