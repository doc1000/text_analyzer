{
  "manifest_version": 2,
  "name": "VaultBubble",
  "version": "0.5.0",
  "description": "Capture and organize selected text, full pages, notes, and tags",
  "permissions": [
    "activeTab",
    "tabs",
    "<all_urls>",
    "contextMenus",
    "storage",
    "http://localhost:8000/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_action": {
    "default_title": "VaultBubble",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "settings.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
  "gecko": {
    "id": "vaultbubble@energyalgorithms.net",
    "data_collection_permissions": {
      "required": [
        "websiteContent",
        "browsingActivity"
      ],
      "optional": [
        "technicalAndInteraction"
      ]
    }
  }
  }
}

