{
  "manifest_version": 3,
  "name": "VaultBubble",
  "version": "0.7.0",
  "description": "Capture web content, organize by topics, and query your research vault with AI-powered search. Cloud sync or local-only storage.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.vaultbubble.com/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "VaultBubble",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  }
}